# Contoh nama variabel saja. Atur nilai di Vercel Project Settings > Environment Variables.
# Jangan pernah commit nilai credential asli atau file .env berisi secret.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MIDTRANS_SERVER_KEY=
PREMIUM_PRICE_IDR=
# Opsional: isi dengan origin deployment yang benar-benar digunakan (mis. URL Preview Vercel).
# Biarkan kosong untuk same-origin jika pembatasan Origin tidak diperlukan.
CHOCO_ALLOWED_ORIGIN=
