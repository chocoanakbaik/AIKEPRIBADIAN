# Environment variables for the Vercel deployment.
# Configure these values in Vercel Project Settings > Environment Variables.
# Never commit real API keys or secret values.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Central TCS licensing backend used by the protected license operations route.
TCS_SUPABASE_URL=
# SUPABASE_SECRET_KEY is provisioned by the Supabase Vercel integration; never expose it to browser code.
